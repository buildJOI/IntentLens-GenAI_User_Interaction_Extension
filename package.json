{
  "name": "intentlens",
  "version": "1.0.0",
  "private": true,
  "description": "IntentLens — multimodal user attention intelligence Chrome extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:proxy": "esbuild src/proxy/index.ts --bundle --platform=node --format=esm --outfile=dist/proxy/index.js --packages=external",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:proxy": "tsx src/proxy/index.ts",
    "start:proxy": "node dist/proxy/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "webgazer": "^3.3.0"
  }
}
