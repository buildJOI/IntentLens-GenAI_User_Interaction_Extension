# Copy to .env in the project root. Never commit real secrets.
# Gemini API key is read only by the local proxy (src/proxy).
# Do not put this value in the extension, dashboard, or client bundles.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PROXY_PORT=8787
PROXY_BIND=127.0.0.1
# Optional shared secret the extension sends as Authorization: Bearer
PROXY_AUTH_TOKEN=
# Requests per minute per client
PROXY_RATE_LIMIT_PER_MIN=20
PROXY_TIMEOUT_MS=30000
